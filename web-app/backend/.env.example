# Application Settings
APP_NAME=Cognivus Health Monitoring System
DEBUG=True

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-access-key-min-32-characters-long
REFRESH_SECRET_KEY=your-super-secret-refresh-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
POSTGRES_USER=cognivus_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cognivus_auth
POSTGRES_HOST=postgres  # Use 'postgres' for Docker, 'localhost' for local development
POSTGRES_PORT=5432

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
